---
layout: base.njk
title: Réserver
permalink: /reserver/
description: Choisis ton studio Studio On et accède à son planning et ses offres.
---

<section class="page-hero page-hero--reserve">
  <span class="page-hero__kicker">Réserver</span>
  <h1 class="page-hero__h reserve-title">Choisis ton studio</h1>
</section>

<section class="reveal" style="padding-top: clamp(28px, 5vw, 64px); padding-bottom: clamp(48px, 7vw, 90px);">
  <div class="studio-pick studio-pick--links">
    {% for s in studios.list %}{% if s.visible != false %}
    {% if s.etat == 'soon' %}
    <div class="studio-pick__card is-soon">
      <span class="studio-pick__status">Coming soon</span>
      <span class="studio-pick__name">{{ s.name }}</span>
      <span class="studio-pick__adr">{{ s.adr | safe }}</span>
      <span class="studio-pick__meta">{{ s.meta | join(" · ") }}</span>
    </div>
    {% else %}
    <a class="studio-pick__card{% if s.etat == 'waitlist' %} is-soon{% endif %}" href="/reserver/{{ s.key }}/">
      <span class="studio-pick__status">{% if s.etat == 'open' %}Ouvert{% elif s.etat == 'earlybird' %}Coming soon{% else %}Liste d'attente{% endif %}</span>
      <span class="studio-pick__name">{{ s.name }}</span>
      <span class="studio-pick__adr">{{ s.adr | safe }}</span>
      <span class="studio-pick__meta">{{ s.meta | join(" · ") }}</span>
      <span class="studio-pick__go">{% if s.etat == 'open' %}Voir le planning{% elif s.etat == 'earlybird' %}Early birds{% else %}Liste d'attente{% endif %} <span aria-hidden="true">→</span></span>
    </a>
    {% endif %}
    {% endif %}{% endfor %}
  </div>
</section>
