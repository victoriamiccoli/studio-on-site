---
layout: base.njk
title: Tarifs
permalink: /tarifs/
description: Le Pilates Reformer en illimité. Tarifs accessibles.
---

{% if not pages.tarifs.hideHero %}
<section class="page-hero">
  {% if pages.tarifs.kicker and not pages.tarifs.hideKicker %}<span class="page-hero__kicker">{{ pages.tarifs.kicker }}</span>{% endif %}
  {% if not pages.tarifs.hideTitle %}<h1 class="page-hero__h{% if pages.tarifs.titleOneLine %} page-hero__h--oneline{% endif %}">{% if pages.tarifs.title %}{{ pages.tarifs.title | replace('[[', '<span class="hl-box">') | replace(']]', '</span>') | safe }}{% if pages.tarifs.titleYellow %}{% if pages.tarifs.titleBreak %}<br>{% else %} {% endif %}{% if pages.tarifs.titleBox %}<span class="hl-box">{{ pages.tarifs.titleYellow | replace('[[', '<span class="hl-box">') | replace(']]', '</span>') | safe }}</span>{% else %}<em>{{ pages.tarifs.titleYellow | replace('[[', '<span class="hl-box">') | replace(']]', '</span>') | safe }}</em>{% endif %}{% endif %}{% else %}Tarifs<br><em>accessibles.</em>{% endif %}</h1>{% endif %}
  {% if not pages.tarifs.hideSubtitle %}<p class="page-hero__p">{% if pages.tarifs.subtitle %}{{ pages.tarifs.subtitle | replace('[[', '<span class="hl-box">') | replace(']]', '</span>') | safe }}{% if pages.tarifs.subtitleYellow %}{% if pages.tarifs.subtitleBreak %}<br>{% else %} {% endif %}{% if pages.tarifs.subtitleBox %}<span class="hl-box">{{ pages.tarifs.subtitleYellow | replace('[[', '<span class="hl-box">') | replace(']]', '</span>') | safe }}</span>{% else %}<em>{{ pages.tarifs.subtitleYellow | replace('[[', '<span class="hl-box">') | replace(']]', '</span>') | safe }}</em>{% endif %}{% endif %}{% else %}Le Pilates Reformer. En illimité.{% endif %}</p>{% endif %}
</section>
{% endif %}

{% if pages.tarifs.bfActive %}{% for p in tarifs.seances %}{% if p.name == (pages.tarifs.bfPackName or "Pack 10 séances") %}
{% set bfOrig = pages.tarifs.bfOrig or p.price %}
{% set bfPrice = pages.tarifs.bfPrice or "120" %}
{% set bfPct = ((bfOrig | float - bfPrice | float) / (bfOrig | float) * 100) | round | int %}
<section class="section--dark bf-band reveal">
  <div class="bf-ghost" aria-hidden="true">Black Friday</div>
  <div class="bf-wrap">
    <span class="bf-kicker">{{ pages.tarifs.bfKicker or "Offre Black Friday · durée limitée" }}</span>
    <h2 class="bf-title">{% if pages.tarifs.bfTitle %}{{ pages.tarifs.bfTitle | safe }}{% else %}Pack <em>10 séances</em>{% endif %}</h2>
    <div class="bf-price">
      <span class="bf-orig">{{ bfOrig }}€</span>
      <span class="bf-now">{{ bfPrice }}<sup>€</sup></span>
      <span class="bf-pct">−{{ bfPct }}%</span>
    </div>
    <p class="bf-sub">{{ pages.tarifs.bfSub or "10 séances de Pilates Reformer · valable 6 mois · dans tous les studios." }}</p>
    <div class="bf-cta"><button type="button" class="btn bf-btn" data-payments="{% for pay in p.payments %}{{ pay.studio }}:{{ pay.id }}{% if not loop.last %};{% endif %}{% endfor %}" data-offer="{{ p.offerId }}" data-title="{{ p.name }} — Black Friday" data-price="{{ bfPrice }}" data-per="{{ p.per }}">{{ pages.tarifs.bfCta or "Profiter de l'offre" }} <span>→</span></button></div>
  </div>
</section>
{% endif %}{% endfor %}{% endif %}

<section class="section--dark reveal" style="padding-top: clamp(40px, 6vw, 80px);">
  <div class="tarifs-grid tarifs-grid--subs" style="margin-top:0;">
    {% for p in tarifs.abonnements %}
    <article class="plan plan--light{% if p.feature %} plan--feature{% endif %}{% if p.popular %} plan--pop{% endif %}">
      <div class="plan__name">{{ p.name }}{% if p.badge %} <span class="plan__badge">{{ p.badge }}</span>{% endif %}{% if p.popular %} <span class="plan__badge plan__badge--pop">★ Le plus populaire</span>{% endif %}</div>
      <div class="plan__price">{{ p.price }}<sup>€</sup><span class="per">{{ p.per }}</span></div>
      {% if p.sub %}<div class="plan__sub">{{ p.sub }}</div>{% endif %}
      <ul class="plan__list">
        {% for f in p.features %}<li>{{ f | safe }}</li>{% endfor %}
      </ul>
      <button type="button" class="plan__cta" data-offer="{{ p.offerId }}" data-payments="{% for pay in p.payments %}{{ pay.studio }}:{{ pay.id }}{% if not loop.last %};{% endif %}{% endfor %}" data-title="{{ p.payTitle or p.name }}" data-price="{{ p.price }}" data-per="{{ p.per }}">{{ p.ctaLabel }} <span>→</span></button>
    </article>
    {% endfor %}
  </div>

  <div class="tarifs-grid" style="margin-top: 14px;">
    {% for p in tarifs.seances %}
    {% set isBF = pages.tarifs.bfActive and p.name == (pages.tarifs.bfPackName or "Pack 10 séances") %}
    {% if isBF %}{% set bfOrig = pages.tarifs.bfOrig or p.price %}{% set bfPrice = pages.tarifs.bfPrice or "120" %}{% set bfPct = ((bfOrig | float - bfPrice | float) / (bfOrig | float) * 100) | round | int %}{% endif %}
    <article class="plan{% if isBF %} plan--eb{% endif %}{% if p.feature %} plan--feature{% endif %}{% if p.popular %} plan--pop{% endif %}">
      <div class="plan__name">{{ p.name }}{% if isBF %} <span class="plan__badge plan__badge--eb">Black Friday</span>{% elif p.badge %} <span class="plan__badge">{{ p.badge }}</span>{% endif %}{% if p.popular %} <span class="plan__badge plan__badge--pop">★ Le plus populaire</span>{% endif %}</div>
      {% if isBF %}
      <div class="plan__price plan__price--eb">
        <span class="plan__orig">{{ bfOrig }}<sup>€</sup></span>
        <span class="plan__now">{{ bfPrice }}<sup>€</sup><span class="per">{{ p.per }}</span></span>
        <span class="plan__pct">−{{ bfPct }}%</span>
      </div>
      <div class="plan__launch">Offre Black Friday</div>
      {% else %}
      <div class="plan__price">{{ p.price }}<sup>€</sup><span class="per">{{ p.per }}</span></div>
      {% if p.sub %}<div class="plan__sub">{{ p.sub }}</div>{% endif %}
      {% endif %}
      <ul class="plan__list">
        {% for f in p.features %}<li>{{ f | safe }}</li>{% endfor %}
      </ul>
      <button type="button" class="plan__cta" data-offer="{{ p.offerId }}" data-payments="{% for pay in p.payments %}{{ pay.studio }}:{{ pay.id }}{% if not loop.last %};{% endif %}{% endfor %}" data-title="{% if isBF %}{{ p.name }} — Black Friday{% else %}{{ p.payTitle or p.name }}{% endif %}" data-price="{% if isBF %}{{ bfPrice }}{% else %}{{ p.price }}{% endif %}" data-per="{{ p.per }}">{{ p.ctaLabel }} <span>→</span></button>
    </article>
    {% endfor %}
  </div>
</section>

{% for s in studios.list %}{% if s.visible and (s.etat == 'earlybird' or s.etat == 'earlybirdopen') and s.showOnTarifs %}
<section class="section--dark reveal" style="text-align:center;">
  <span class="page-hero__kicker" style="color:var(--vanille)">{{ s.ebKicker or "Coming soon" }}</span>
  <h2 class="page-hero__h">{% if s.ebTitle or s.ebTitleYellow %}{% if s.ebTitle %}{{ s.ebTitle }}{% endif %}{% if s.ebTitleYellow %} <em>{{ s.ebTitleYellow }}</em>{% endif %}{% else %}<em>{{ s.status or 'Ouverture bientôt' }}</em>{% endif %}</h2>
  <p class="page-hero__p" style="max-width:60ch;">{{ s.ebSubtitle or "Profite des offres early bird : réserve ta place à tarif préférentiel avant l'ouverture du studio." }}</p>
  <div style="margin-top:26px;"><a href="/reserver/{{ s.key }}/" class="btn eb-btn">{{ s.tarifsTeaserCta or "Accéder aux offres early bird" }} <span>→</span></a></div>
</section>
{% endif %}{% endfor %}

{% if blocks and blocks.tarifs %}{% for block in blocks.tarifs %}{% if not block.hidden %}{% include "render-block.njk" %}{% endif %}{% endfor %}{% endif %}

{% if not pages.tarifs.hideContact %}
<section class="reveal">
  <div class="section-meta section-head">
    <div>
      <h2 class="h-xl section-head__h">{% if pages.tarifs.contactTitle %}{{ pages.tarifs.contactTitle | replace('[[', '<span class="hl-box">') | replace(']]', '</span>') | safe }}{% else %}Une question&nbsp;?{% endif %}</h2>
      <p class="section-head__p" style="color: var(--noir); opacity:.65;">{{ pages.tarifs.contactText or "Écris-nous, on te répond très vite." }}</p>
    </div>
  </div>
  <div class="cta-band__actions" style="align-items:center; flex-direction:row; justify-content:center; gap:12px; flex-wrap:wrap;">
    <a href="/contact/" class="btn btn--noir">Nous écrire <span>→</span></a>
  </div>
</section>
{% endif %}
