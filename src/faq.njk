---
layout: base.njk
title: FAQ
permalink: /faq/
description: Les vraies questions sur Studio On et le Pilates Reformer.
---

{% if not pages.faq.hideHero %}
<section class="page-hero">
  {% if not pages.faq.hideKicker %}<span class="page-hero__kicker">{{ pages.faq.kicker or "FAQ" }}</span>{% endif %}
  {% if not pages.faq.hideTitle %}<h1 class="page-hero__h">{% if pages.faq.title %}{{ pages.faq.title | replace('[[', '<span class="hl-box">') | replace(']]', '</span>') | safe }}{% else %}Les vraies<br><em>questions.</em>{% endif %}</h1>{% endif %}
  {% if not pages.faq.hideSubtitle %}<p class="page-hero__p">{% if pages.faq.subtitle %}{{ pages.faq.subtitle | replace('[[', '<span class="hl-box">') | replace(']]', '</span>') | safe }}{% else %}Si ta question n'y est pas, écris-nous, on y répond très vite&nbsp;!{% endif %}</p>{% endif %}
</section>
{% endif %}

<section class="reveal">
  <div class="faq">
    {% for item in faq.list %}
    <details{% if loop.first %} open{% endif %}>
      <summary>{{ item.q | safe }}</summary>
      <div class="faq__body">{{ item.a | safe }}</div>
    </details>
    {% endfor %}
  </div>
</section>

<section class="cta-band reveal">
  <h2 class="cta-band__h">Une autre<br>question&nbsp;?</h2>
  <div class="cta-band__side">
    <p class="cta-band__p" style="color: var(--vanille); opacity: 1;">Écris-nous, on répond vite.</p>
    <div class="cta-band__actions">
      <a href="/contact/" class="btn btn--ecru">Nous écrire <span class="btn__toggle"></span></a>
    </div>
  </div>
</section>

{% if blocks and blocks.faq %}{% for block in blocks.faq %}{% if not block.hidden %}{% include "render-block.njk" %}{% endif %}{% endfor %}{% endif %}
