---
layout: base.njk
title: Franchises
permalink: /franchises/
description: Ouvrir un studio Studio On en franchise. Déposez votre candidature.
---

{% if not pages.franchises.hideHero %}
<section class="page-hero">
  {% if pages.franchises.kicker and not pages.franchises.hideKicker %}<span class="page-hero__kicker">{{ pages.franchises.kicker }}</span>{% endif %}
  {% if not pages.franchises.hideTitle %}<h1 class="page-hero__h{% if pages.franchises.titleOneLine %} page-hero__h--oneline{% endif %}">{% if pages.franchises.title %}{{ pages.franchises.title | replace('[[', '<span class="hl-box">') | replace(']]', '</span>') | safe }}{% if pages.franchises.titleYellow %}{% if pages.franchises.titleBreak %}<br>{% else %} {% endif %}{% if pages.franchises.titleBox %}<span class="hl-box">{{ pages.franchises.titleYellow | replace('[[', '<span class="hl-box">') | replace(']]', '</span>') | safe }}</span>{% else %}<em>{{ pages.franchises.titleYellow | replace('[[', '<span class="hl-box">') | replace(']]', '</span>') | safe }}</em>{% endif %}{% endif %}{% else %}Ouvre ton<br>studio <span class="logo logo--inline-yellow" style="vertical-align: baseline; gap: 0.02em;">{% include "toggle.njk" %}<span class="logo__text">n.</span></span>{% endif %}</h1>{% endif %}
  {% if not pages.franchises.hideSubtitle %}<p class="page-hero__p">{% if pages.franchises.subtitle %}{{ pages.franchises.subtitle | replace('[[', '<span class="hl-box">') | replace(']]', '</span>') | safe }}{% if pages.franchises.subtitleYellow %}{% if pages.franchises.subtitleBreak %}<br>{% else %} {% endif %}{% if pages.franchises.subtitleBox %}<span class="hl-box">{{ pages.franchises.subtitleYellow | replace('[[', '<span class="hl-box">') | replace(']]', '</span>') | safe }}</span>{% else %}<em>{{ pages.franchises.subtitleYellow | replace('[[', '<span class="hl-box">') | replace(']]', '</span>') | safe }}</em>{% endif %}{% endif %}{% else %}Un concept clé en main, rentable et différenciant. Dis-nous qui tu es, on revient vers toi très vite.{% endif %}</p>{% endif %}
</section>
{% endif %}

<section class="reveal">
  <div class="form-wrap">
    <form id="franchiseForm" class="form" data-webhook="{{ site.franchiseWebhook }}" novalidate>
      <input type="hidden" name="type" value="Franchise">
      <div class="field">
        <label for="nom">Nom *</label>
        <input type="text" id="nom" name="nom" required autocomplete="family-name">
      </div>
      <div class="field">
        <label for="prenom">Prénom *</label>
        <input type="text" id="prenom" name="prenom" required autocomplete="given-name">
      </div>
      <div class="field">
        <label for="email">Email *</label>
        <input type="email" id="email" name="email" required autocomplete="email">
      </div>
      <div class="field">
        <label for="tel">Téléphone *</label>
        <input type="tel" id="tel" name="telephone" required autocomplete="tel">
      </div>
      <div class="field">
        <label for="ville">Ville / zone souhaitée *</label>
        <input type="text" id="ville" name="ville" required>
      </div>
      <div class="field">
        <label for="apport">Apport disponible *</label>
        <select id="apport" name="apport" required>
          <option value="">Sélectionner</option>
          <option>Moins de 30 000 €</option>
          <option>30 000 – 50 000 €</option>
          <option>50 000 – 80 000 €</option>
          <option>Plus de 80 000 €</option>
        </select>
      </div>
      <div class="field">
        <label for="profil">Profil *</label>
        <select id="profil" name="profil" required>
          <option value="">Sélectionner</option>
          <option>Investisseur</option>
          <option>Entrepreneur / exploitant</option>
          <option>Les deux</option>
        </select>
      </div>
      <div class="field">
        <label for="horizon">À quel horizon souhaites-tu ouvrir ? *</label>
        <select id="horizon" name="horizon" required>
          <option value="">Sélectionner</option>
          <option>Moins de 3 mois</option>
          <option>3 à 6 mois</option>
          <option>6 à 12 mois</option>
          <option>Plus de 12 mois</option>
        </select>
      </div>
      <div class="field full">
        <label for="message">Votre projet en quelques mots</label>
        <textarea id="message" name="message" placeholder="Motivation, expérience, calendrier envisagé…"></textarea>
      </div>
      <p class="form__note full">* Champs obligatoires. Vos informations sont utilisées uniquement pour traiter votre candidature.</p>
      <div class="form__submit">
        <button type="submit" class="btn btn--vanille" id="franchiseSubmit">Envoyer ma candidature <span>→</span></button>
      </div>
    </form>

    <div class="form-success" id="franchiseSuccess">
      <h3 class="h-md" style="margin-bottom:12px;">Merci, c'est envoyé&nbsp;!</h3>
      <p style="opacity:.75; max-width: 40ch; margin: 0 auto;">On a bien reçu ta candidature. On revient vers toi très vite.</p>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('franchiseForm');
  const success = document.getElementById('franchiseSuccess');
  const submitBtn = document.getElementById('franchiseSubmit');
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) { form.reportValidity(); return; }
    const webhook = form.dataset.webhook;
    const data = Object.fromEntries(new FormData(form).entries());
    data.source = 'Site · page Franchises';
    submitBtn.disabled = true;
    submitBtn.textContent = 'Envoi…';
    try {
      if (webhook) {
        await fetch(webhook, { method: 'POST', mode: 'no-cors', body: new URLSearchParams(data) });
      } else {
        console.log('[Franchise] Aucun webhook configuré. Données :', data);
      }
      window.location.href = '/franchise/merci/';
    } catch (err) {
      submitBtn.disabled = false;
      submitBtn.innerHTML = 'Réessayer <span>→</span>';
      alert("Une erreur est survenue. Merci de réessayer ou de nous écrire directement.");
    }
  });
</script>

{% if blocks and blocks.franchises %}{% for block in blocks.franchises %}{% if not block.hidden %}{% include "render-block.njk" %}{% endif %}{% endfor %}{% endif %}
