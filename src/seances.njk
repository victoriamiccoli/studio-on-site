---
layout: base.njk
title: Séances
permalink: /seances/
description: Plus de 100 séances de Pilates Reformer, à ton rythme.
---

{% if not pages.seances.hideHero %}
<section class="page-hero">
  {% if pages.seances.kicker and not pages.seances.hideKicker %}<span class="page-hero__kicker">{{ pages.seances.kicker }}</span>{% endif %}
  {% if not pages.seances.hideTitle %}<h1 class="page-hero__h{% if pages.seances.titleOneLine %} page-hero__h--oneline{% endif %}">{% if pages.seances.title %}{{ pages.seances.title | replace('[[', '<span class="hl-box">') | replace(']]', '</span>') | safe }}{% if pages.seances.titleYellow %}{% if pages.seances.titleBreak %}<br>{% else %} {% endif %}{% if pages.seances.titleBox %}<span class="hl-box">{{ pages.seances.titleYellow | replace('[[', '<span class="hl-box">') | replace(']]', '</span>') | safe }}</span>{% else %}<em>{{ pages.seances.titleYellow | replace('[[', '<span class="hl-box">') | replace(']]', '</span>') | safe }}</em>{% endif %}{% endif %}{% else %}Plus de 100 séances,<br><em>à ton rythme.</em>{% endif %}</h1>{% endif %}
  {% if not pages.seances.hideSubtitle %}<p class="page-hero__p">{% if pages.seances.subtitle %}{{ pages.seances.subtitle | replace('[[', '<span class="hl-box">') | replace(']]', '</span>') | safe }}{% if pages.seances.subtitleYellow %}{% if pages.seances.subtitleBreak %}<br>{% else %} {% endif %}{% if pages.seances.subtitleBox %}<span class="hl-box">{{ pages.seances.subtitleYellow | replace('[[', '<span class="hl-box">') | replace(']]', '</span>') | safe }}</span>{% else %}<em>{{ pages.seances.subtitleYellow | replace('[[', '<span class="hl-box">') | replace(']]', '</span>') | safe }}</em>{% endif %}{% endif %}{% else %}Filtre par niveau, focus, mood ou coach. De nouvelles vidéos en continu.{% endif %}</p>{% endif %}
</section>
{% endif %}

{% set DEFAULT_INTRO = [
  { "kick": "Première fois", "h": "On a la séance parfaite.", "p": "Des séances pensées pour les premières fois : installation, prise en main du Reformer, respiration, posture. La séance qui te donnera envie de revenir&nbsp;!" },
  { "kick": "Niveau confirmé", "h": "De quoi te faire transpirer.", "p": "Des séances intenses, des pulses, le cardio ON FIRE, des séries longues, du gainage profond… Des séances comme tu les aimes&nbsp;!" },
  { "kick": "Tous les objectifs", "h": "Ton corps, ton programme.", "p": "Tonifier, gagner en mobilité, soulager le dos, se renforcer ou juste souffler : tu filtres et tu trouves ta séance du jour." }
] %}
{% set introCols = seances.intro if (seances.intro and seances.intro.length) else DEFAULT_INTRO %}

<section class="section--dark reveal" style="padding-top: clamp(12px, 1.8vw, 24px);">
  <div class="section-meta section-head" style="padding-top: 0; padding-bottom: clamp(30px, 4vw, 48px);">
    <div class="filter-pills">
      {% for f in seances.filters %}<span class="filter-pill{% if loop.first %} filter-pill--active{% endif %}">{{ f }}</span>{% endfor %}
    </div>
  </div>

  {% if not seances.hideIntro %}
  <div class="sea__cols">
    {% for col in introCols %}
    <article class="sea-col">
      {% if col.kick %}<span class="sea-col__kick">{{ col.kick }}</span>{% endif %}
      {% if col.h %}<h3 class="sea-col__h">{{ col.h | safe }}</h3>{% endif %}
      {% if col.p %}<p class="sea-col__p">{{ col.p | safe }}</p>{% endif %}
    </article>
    {% endfor %}
  </div>
  {% endif %}

  <div class="gallery" id="seanceGallery">
    {% for s in seances.list %}
    <div class="gal-cell{% if s.dark %} gal-cell--dark{% endif %}{% if s.tall %} gal-cell--tall{% endif %}{% if s.wide %} gal-cell--wide{% endif %}"{% if s.image %} style="background-image:url('{{ s.image }}')"{% endif %} data-cats="{{ (s.cats or []) | join(',') }}">
      {% if not s.image %}<span class="ph-label">{{ s.title }}</span>{% endif %}
      {% if s.badge %}<span class="gal-badge">{{ s.badge }}</span>{% endif %}
      {% if s.play %}<div class="gal-play" aria-hidden="true"></div>{% endif %}
      <div class="gal-switch">
        <span class="gal-switch__text">{{ s.title }}</span>
        <span class="gal-switch__meta">{{ s.meta }}</span>
      </div>
    </div>
    {% endfor %}
  </div>
</section>


{% if blocks and blocks.seances %}{% for block in blocks.seances %}{% if not block.hidden %}{% include "render-block.njk" %}{% endif %}{% endfor %}{% endif %}
