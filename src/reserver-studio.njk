---
pagination:
  data: studios.list
  size: 1
  alias: studio
layout: base.njk
permalink: "/reserver/{{ studio.key }}/"
eleventyComputed:
  title: "Réserver · {{ studio.name }}"
---

<section class="page-hero page-hero--reserve">
  <a href="/reserver/" class="reserve-back"><span aria-hidden="true">←</span> Choisir un autre studio</a>
</section>

{% set showPlan = studio.planning and (studio.etat == 'open' or (studio.etat == 'earlybird' and studio.showPlanning)) %}
{% if studio.etat == 'earlybird' %}
<section class="section--dark reveal" style="padding-top: 0; padding-bottom: clamp(24px, 4vw, 44px); text-align:center;">
  <div style="padding-top: 8px;">
    <span class="page-hero__kicker" style="color:var(--vanille)">{{ studio.ebKicker or "Coming soon" }}</span>
    <h1 class="page-hero__h">{% if studio.ebTitle or studio.ebTitleYellow %}{% if studio.ebTitle %}{{ studio.ebTitle }}{% endif %}{% if studio.ebTitleYellow %} <em>{{ studio.ebTitleYellow }}</em>{% endif %}{% else %}<em>{{ studio.status or 'Ouverture bientôt' }}</em>{% endif %}</h1>
    <p class="page-hero__p" style="max-width: 72ch;">{{ studio.ebSubtitle or "Profite des offres early bird : réserve ta place à tarif préférentiel avant l'ouverture du studio." }}</p>
  </div>
</section>
{% endif %}

{% if showPlan and studio.etat != 'earlybird' %}
<section class="section--dark reveal" id="reserverPanel" style="padding-top: 0;">
  <div class="section-meta section-head" style="padding-top: 40px; padding-bottom: 40px;">
    <div>
      <h2 class="h-lg section-head__h" style="color: var(--ecru); max-width: 20ch;">{{ studio.name }}</h2>
      <p class="section-head__p" style="color: var(--ecru); opacity:.8;">Choisis ton créneau ci-dessous.</p>
    </div>
  </div>
  <div class="planning-wrap"><div id="sportigo-appointment-container"></div></div>
</section>
{% endif %}

{% if studio.etat != 'earlybird' %}{% include "reserve-info.njk" %}{% endif %}

{% if (studio.etat == 'open' and studio.planning) or studio.etat == 'earlybird' %}
<section class="reveal{% if studio.etat == 'earlybird' %} section--dark{% endif %}"{% if studio.etat == 'earlybird' %} style="padding-top: 8px;"{% endif %}>
  {% if studio.etat != 'earlybird' or studio.ebOffersTitle or studio.ebOffersSubtitle %}
  <div class="section-meta section-head">
    <div>
      {% if studio.etat == 'earlybird' %}
        {% if studio.ebOffersTitle %}<h2 class="h-xl section-head__h" style="max-width: 14ch; font-size: clamp(32px, 8vw, 65px); color: var(--ecru)">{{ studio.ebOffersTitle | safe }}</h2>{% endif %}
        {% if studio.ebOffersSubtitle %}<p class="section-head__p" style="color: var(--ecru); opacity:.65; max-width: none;">{{ studio.ebOffersSubtitle }}</p>{% endif %}
      {% else %}
        <h2 class="h-xl section-head__h" style="max-width: 14ch; font-size: clamp(32px, 8vw, 65px)">Abonnements<br>&amp; séances</h2>
        <p class="section-head__p" style="color: var(--noir); opacity:.65;">Ton studio de référence : {{ studio.name }}. Choisis ta formule.</p>
      {% endif %}
    </div>
  </div>
  {% endif %}

  {% set useEarly = studio.etat == 'earlybird' and studio.earlyOffers and studio.earlyOffers.length %}
  {% if useEarly %}
  <div class="tarifs-grid tarifs-grid--subs" style="margin-top:0;">
    {% for o in studio.earlyOffers %}{% if o.group != 'seance' %}{% include "eb-offer.njk" %}{% endif %}{% endfor %}
  </div>
  <div class="tarifs-grid" style="margin-top: 14px;">
    {% for o in studio.earlyOffers %}{% if o.group == 'seance' %}{% include "eb-offer.njk" %}{% endif %}{% endfor %}
  </div>
  {% else %}
  <div class="tarifs-grid tarifs-grid--subs" style="margin-top:0;">
    {% for p in tarifs.abonnements %}
    <article class="plan plan--light{% if p.feature %} plan--feature{% endif %}">
      <div class="plan__name">{{ p.name }}{% if p.badge %} <span class="plan__badge">{{ p.badge }}</span>{% endif %}</div>
      <div class="plan__price">{{ p.price }}<sup>€</sup><span class="per">{{ p.per }}</span></div>
      {% if p.sub %}<div class="plan__sub">{{ p.sub }}</div>{% endif %}
      <ul class="plan__list">{% for f in p.features %}<li>{{ f | safe }}</li>{% endfor %}</ul>
      <button type="button" class="plan__cta" data-offer="{{ p.offerId }}" data-payments="{% for pay in p.payments %}{{ pay.studio }}:{{ pay.id }}{% if not loop.last %};{% endif %}{% endfor %}" data-title="{{ p.payTitle or p.name }}" data-price="{{ p.price }}" data-per="{{ p.per }}">{{ p.ctaLabel }} <span>→</span></button>
    </article>
    {% endfor %}
  </div>
  <div class="tarifs-grid" style="margin-top: 14px;">
    {% for p in tarifs.seances %}
    <article class="plan{% if p.feature %} plan--feature{% endif %}">
      <div class="plan__name">{{ p.name }}{% if p.badge %} <span class="plan__badge">{{ p.badge }}</span>{% endif %}</div>
      <div class="plan__price">{{ p.price }}<sup>€</sup><span class="per">{{ p.per }}</span></div>
      {% if p.sub %}<div class="plan__sub">{{ p.sub }}</div>{% endif %}
      <ul class="plan__list">{% for f in p.features %}<li>{{ f | safe }}</li>{% endfor %}</ul>
      <button type="button" class="plan__cta" data-offer="{{ p.offerId }}" data-payments="{% for pay in p.payments %}{{ pay.studio }}:{{ pay.id }}{% if not loop.last %};{% endif %}{% endfor %}" data-title="{{ p.payTitle or p.name }}" data-price="{{ p.price }}" data-per="{{ p.per }}">{{ p.ctaLabel }} <span>→</span></button>
    </article>
    {% endfor %}
  </div>
  {% endif %}
</section>
{% if showPlan and studio.etat == 'earlybird' %}
<section class="section--dark reveal" id="reserverPanel" style="padding-top: 0;">
  <div class="section-meta section-head" style="padding-top: 40px; padding-bottom: 40px;">
    <div>
      <h2 class="h-lg section-head__h" style="color: var(--ecru); max-width: 20ch;">Réserve ta place</h2>
      <p class="section-head__p" style="color: var(--ecru); opacity:.8;">Choisis ton créneau ci-dessous.</p>
    </div>
  </div>
  <div class="planning-wrap"><div id="sportigo-appointment-container"></div></div>
</section>
{% endif %}
{% if studio.etat == 'earlybird' %}{% include "reserve-info.njk" %}{% endif %}
{% else %}
<section class="section--dark reveal">
  <div class="section-head" style="text-align:center;">
    <h2 class="h-lg" style="color: var(--ecru);">Ouverture <span style="color:var(--vanille)">{{ studio.status or 'bientôt' }}</span></h2>
    <p style="margin: 18px auto 0; max-width: 42ch; opacity:.8; color: var(--ecru); font-size:15px; line-height:1.6;">Ce studio ouvre bientôt&nbsp;! En attendant, rejoins la liste d'attente pour être prévenu dès l'ouverture, ou choisis un autre studio.</p>
    <div style="margin-top:28px; display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
      <button type="button" class="btn btn--ecru" data-waitlist data-studio="{{ studio.name }}">Rejoindre la liste d'attente <span class="btn__toggle"></span></button>
      <a href="/reserver/" class="btn" style="border:1px solid rgba(240,236,225,.4); color: var(--ecru);">Choisir un autre studio <span>→</span></a>
    </div>
  </div>
</section>
{% endif %}

<script>
document.body.setAttribute('data-studio-ref', '{{ studio.key }}');
{% if showPlan %}
(function(){
  var ACCOUNT = "{{ studio.sportigoAccount or site.sportigoAccount }}";
  var SRC = "https://standalone.api.sportigo.fr/component-standalone.js";
  var container = document.getElementById('sportigo-appointment-container');
  var st = 0, cbs = [];
  function load(cb){
    if (st === 2){ cb(); return; }
    cbs.push(cb); if (st === 1) return; st = 1;
    var s = document.createElement('script'); s.src = SRC;
    s.onload = function(){ st = 2; cbs.forEach(function(f){ f(); }); cbs = []; };
    s.onerror = function(){ st = 0; container.innerHTML = '<p style="padding:40px;text-align:center;opacity:.7;color:var(--ecru)">Impossible de charger le planning pour le moment. Réessaie dans un instant.</p>'; };
    document.head.appendChild(s);
  }
  container.innerHTML = '<p style="padding:40px;text-align:center;opacity:.7;color:var(--ecru)">Chargement du planning…</p>';
  load(function(){
    container.innerHTML = '<div id="sportigo-appointment-full-container"></div>';
    try {
      window.initComponent("AppointmentFull", "sportigo-appointment-full-container", ACCOUNT, {
        theme: { googleFont: { name: "Inter" } },
        planning: {{ studio.planning }},
        displayMode: "slide"
      });
    } catch(e){
      container.innerHTML = '<p style="padding:40px;text-align:center;opacity:.7;color:var(--ecru)">Une erreur est survenue. Réessaie ou contacte-nous.</p>';
    }
  });
})();
{% endif %}
</script>
