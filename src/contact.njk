---
layout: base.njk
title: Contact
permalink: /contact/
description: Une question ? Écris-nous, on répond très vite.
---

{% if not pages.contact.hideHero %}
<section class="page-hero">
  {% if pages.contact.kicker and not pages.contact.hideKicker %}<span class="page-hero__kicker">{{ pages.contact.kicker }}</span>{% endif %}
  {% if not pages.contact.hideTitle %}<h1 class="page-hero__h{% if pages.contact.titleOneLine %} page-hero__h--oneline{% endif %}">{% if pages.contact.title %}{{ pages.contact.title | replace('[[', '<span class="hl-box">') | replace(']]', '</span>') | safe }}{% if pages.contact.titleYellow %}{% if pages.contact.titleBreak %}<br>{% else %} {% endif %}{% if pages.contact.titleBox %}<span class="hl-box">{{ pages.contact.titleYellow | replace('[[', '<span class="hl-box">') | replace(']]', '</span>') | safe }}</span>{% else %}<em>{{ pages.contact.titleYellow | replace('[[', '<span class="hl-box">') | replace(']]', '</span>') | safe }}</em>{% endif %}{% endif %}{% else %}Une question&nbsp;?<br><em>Écris-nous.</em>{% endif %}</h1>{% endif %}
  {% if not pages.contact.hideSubtitle %}<p class="page-hero__p">{% if pages.contact.subtitle %}{{ pages.contact.subtitle | replace('[[', '<span class="hl-box">') | replace(']]', '</span>') | safe }}{% if pages.contact.subtitleYellow %}{% if pages.contact.subtitleBreak %}<br>{% else %} {% endif %}{% if pages.contact.subtitleBox %}<span class="hl-box">{{ pages.contact.subtitleYellow | replace('[[', '<span class="hl-box">') | replace(']]', '</span>') | safe }}</span>{% else %}<em>{{ pages.contact.subtitleYellow | replace('[[', '<span class="hl-box">') | replace(']]', '</span>') | safe }}</em>{% endif %}{% endif %}{% else %}On te répond très vite. Tu peux aussi nous joindre au {{ site.contactPhone }}.{% endif %}</p>{% endif %}
</section>
{% endif %}

<section class="reveal">
  <div class="form-wrap">
    <form id="contactForm" class="form" data-webhook="{{ site.contactWebhook }}" novalidate>
      <input type="hidden" name="type" value="Contact">
      <div class="field">
        <label for="c-nom">Nom *</label>
        <input type="text" id="c-nom" name="nom" required autocomplete="family-name">
      </div>
      <div class="field">
        <label for="c-prenom">Prénom *</label>
        <input type="text" id="c-prenom" name="prenom" required autocomplete="given-name">
      </div>
      <div class="field">
        <label for="c-email">Email *</label>
        <input type="email" id="c-email" name="email" required autocomplete="email">
      </div>
      <div class="field">
        <label for="c-tel">Téléphone</label>
        <input type="tel" id="c-tel" name="telephone" autocomplete="tel">
      </div>
      <div class="field full">
        <label for="c-message">Votre message *</label>
        <textarea id="c-message" name="message" required placeholder="Comment peut-on t'aider ?"></textarea>
      </div>
      <p class="form__note full">* Champs obligatoires. Vos informations sont utilisées uniquement pour répondre à votre message.</p>
      <div class="form__submit">
        <button type="submit" class="btn btn--noir" id="contactSubmit">Envoyer mon message <span>→</span></button>
      </div>
    </form>

    <div class="form-success" id="contactSuccess">
      <h3 class="h-md" style="margin-bottom:12px;">Message envoyé&nbsp;!</h3>
      <p style="opacity:.75; max-width: 40ch; margin: 0 auto;">Merci, on a bien reçu ton message. On te répond très vite par email.</p>
    </div>
  </div>
</section>

<script>
  var cform = document.getElementById('contactForm');
  var csuccess = document.getElementById('contactSuccess');
  var csubmit = document.getElementById('contactSubmit');
  cform.addEventListener('submit', function(e){
    e.preventDefault();
    if (!cform.checkValidity()) { cform.reportValidity(); return; }
    var webhook = cform.dataset.webhook;
    var data = {}; new FormData(cform).forEach(function(v,k){ data[k]=v; });
    data.source = 'Site · page Contact';
    csubmit.disabled = true; csubmit.textContent = 'Envoi…';
    Promise.resolve(webhook ? fetch(webhook, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(data) }) : console.log('[Contact]', data))
      .then(function(){ cform.style.display='none'; csuccess.classList.add('is-visible'); })
      .catch(function(){ csubmit.disabled=false; csubmit.innerHTML='Réessayer <span>→</span>'; });
  });
</script>

{% if blocks and blocks.contact %}{% for block in blocks.contact %}{% if not block.hidden %}{% include "render-block.njk" %}{% endif %}{% endfor %}{% endif %}
